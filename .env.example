APP_ENV=development
APP_DATABASE_URL=sqlite:///./data/psychology_growth.db
APP_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
SOURCE_STORAGE_ROOT=./data/source_files

# DeepSeek (optional; system remains usable without it)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60

# Safety / privacy
LOG_LEVEL=INFO
ALLOW_NETWORK_PLUGINS=false
# Compose binds web/api to loopback by default.
HOST_BIND=127.0.0.1

# Desktop runtime (normally injected by the Tauri shell; do not commit real tokens)
APP_DATA_ROOT=
PG_DESKTOP_TOKEN=
ARTIFACT_STORAGE_ROOT=

# v0.7 remote device authentication (single owner, many devices)
# Set PG_REMOTE_AUTH_ENABLED=true only for the authenticated remote deployment
# behind the TLS reverse proxy (see docker-compose.remote.yml). The loopback
# development/Compose mode and desktop-local mode must leave it false.
PG_REMOTE_AUTH_ENABLED=false
# One-time owner bootstrap gate; a strong random value, injected via the
# remote deployment env, never committed.
PG_OWNER_BOOTSTRAP_TOKEN=
# Optional tuning (seconds); defaults: 900 (access), 30 days (renewal).
PG_ACCESS_TOKEN_TTL_SECONDS=900
PG_REFRESH_TOKEN_TTL_SECONDS=2592000
# Brute-force/rate controls for auth endpoints.
PG_AUTH_RATE_LIMIT_ATTEMPTS=10
PG_AUTH_RATE_LIMIT_WINDOW_SECONDS=900
