{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Interest Growth",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState",
          "radius": 12
        }
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ]
  }
}
