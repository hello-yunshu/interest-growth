# Install inside Nginx's http context, replace the hostname/certificate paths,
# then validate with `nginx -t`. Docker remains on loopback HTTP; Nginx owns the
# client-facing HTTPS boundary.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream interest_growth_api {
    server 127.0.0.1:8000;
}

upstream interest_growth_web {
    server 127.0.0.1:3000;
}

server {
    listen 80;
    server_name interest.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name interest.example.com;

    ssl_certificate     /etc/letsencrypt/live/interest.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/interest.example.com/privkey.pem;

    client_max_body_size 50m;

    location /api/ {
        proxy_pass http://interest_growth_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite rather than append: the API uses the first forwarded IP for
        # rate limiting and must not receive a client-supplied spoofed prefix.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
    }

    location / {
        proxy_pass http://interest_growth_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
}
