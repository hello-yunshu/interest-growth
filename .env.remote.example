# Interest Growth v0.7 — authenticated remote deployment env template.
# Copy to .env.remote, fill secrets, keep this file OUT of Git.

APP_ENV=remote
APP_DATABASE_URL=sqlite:////app/data/psychology_growth.db
SOURCE_STORAGE_ROOT=/app/data/source_files
ARTIFACT_STORAGE_ROOT=/app/data/artifacts

# Docker serves plain HTTP on loopback by default. Put an external Nginx/Caddy
# HTTPS endpoint in front of these ports for access from another device.
REMOTE_BIND=127.0.0.1
REMOTE_API_PORT=8000
REMOTE_WEB_PORT=3000
REMOTE_PUBLIC_API_BASE=/api

# Remote device authentication. PG_REMOTE_AUTH_ENABLED is forced true by the
# remote compose profile; PG_OWNER_BOOTSTRAP_TOKEN gates first-owner creation.
PG_OWNER_BOOTSTRAP_TOKEN=
PG_REMOTE_AUTH_ENABLED=true
PG_ACCESS_TOKEN_TTL_SECONDS=900
PG_REFRESH_TOKEN_TTL_SECONDS=2592000
PG_AUTH_RATE_LIMIT_ATTEMPTS=10
PG_AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Provider secrets are server-owned and injected here, never in the image.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60

# Safety
LOG_LEVEL=INFO
ALLOW_NETWORK_PLUGINS=false
